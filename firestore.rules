rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ─── USUARIOS ───
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && request.resource.data.role == "user";
      
      // El usuario puede actualizar su perfil, pero NO puede cambiarse el rol ni el estado de verificación
      // Usamos .get() para evitar errores si los campos no existen en usuarios viejos
      allow update: if isOwner(userId) &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
        request.resource.data.get('phoneVerified', false) == resource.data.get('phoneVerified', false) &&
        request.resource.data.get('uid', '') == resource.data.get('uid', '') &&
        request.resource.data.get('email', '') == resource.data.get('email', '');

      // El admin tiene control total
      allow write: if isAdmin();
    }

    // ─── CLIENTES ───
    match /clients/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── SETTINGS ───
    match /settings/{docId} {
      // Público: necesario para que cualquier visitante consulte horarios de atención
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── SERVICIOS (Catálogo) ───
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── CATEGORÍAS DE SERVICIOS ───
    match /serviceCategories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── TURNOS ───
    match /appointments/{docId} {
      // Admin tiene control total sobre todos los turnos (incluyendo pasados)
      allow read, write: if isAdmin();

      // Permitir leer turnos para consultar disponibilidad de horarios en el frontend
      allow read: if true;

      // Creación:
      // Caso 1: Usuario autenticado que crea a su propio nombre
      // Caso 2: Invitado (sin sesión) con nombre y teléfono válidos
      allow create: if
        (
          isAuthenticated()
          && request.resource.data.clientId == request.auth.uid
          && request.resource.data.date >= request.time
        )
        ||
        (
          (request.resource.data.clientId == null || request.resource.data.clientId == '')
          && request.resource.data.clientName is string && request.resource.data.clientName.size() >= 2
          && request.resource.data.clientPhone is string && request.resource.data.clientPhone.size() >= 6
          && request.resource.data.date >= request.time
          && request.resource.data.status == 'pending'
        );

      // Usuario: solo puede cancelar (status='cancelled') sus propios turnos.
      allow update: if isAuthenticated()
        && resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'cancelled';
    }

    // ─── INGRESOS ───
    match /income/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── NOTIFICACIONES ───
    match /notifications/{docId} {
      // El admin puede ver, marcar como leídas, etc.
      allow read, write: if isAdmin();
      // Cualquier reserva (autenticada o de invitado) puede generar la notificación de nuevo turno
      allow create: if true;
    }

    // ─── HISTORIAL DE FIDELIDAD ───
    match /loyaltyHistory/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── TRABAJOS (PORTFOLIO) ───
    match /works/{workId} {
      // Admin: CRUD total
      allow read, write: if isAdmin();
      
      // Público no autenticado y clientes autenticados: pueden leer cualquier trabajo.
      allow read: if true;
      
      // Solo el admin puede crear, editar y eliminar trabajos.
      allow write: if isAdmin();
    }
  }
}
